+// Functions of a fixed-address image that neither a call nor a pointer names: the game
+// reaches them through a table it builds at run time, and a function begins with its
+// stack frame. The game then runs them instead of stopping for missing code.
+std::vector<std::uint32_t> prologue_starts(const Snr2Module &m) {
+    std::vector<std::uint32_t> starts;
+    for (std::uint32_t at = m.code_begin; at + 4 <= m.code_end; at += 4) {
+        const std::uint32_t w = word_at(m, at);
+        if ((w & 0xFFFF8000u) == 0x27BD8000u || (w & 0xFFFF8000u) == 0x67BD8000u) starts.push_back(m.base + at);
+    }
+    return starts;
